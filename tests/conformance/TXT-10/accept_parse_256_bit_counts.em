# G8-4 (D-528, the owner's ruling) — `parse` reads `i256` and `u256` over their whole range, with
# the statuses the narrower integers give: `Overflow` only past the real top (or below the real
# bottom), however far past it the text goes.

println("57896044618658097711785492504343953926634992332820282019728792003956564819967".parse[i256](), "57896044618658097711785492504343953926634992332820282019728792003956564819968".parse[i256](), "-57896044618658097711785492504343953926634992332820282019728792003956564819968".parse[i256](), "-57896044618658097711785492504343953926634992332820282019728792003956564819969".parse[i256]())

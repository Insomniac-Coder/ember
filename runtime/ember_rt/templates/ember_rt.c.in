static const size_t ember_lower_table_len = sizeof ember_lower_table / sizeof ember_lower_table[0];
/* END GENERATED: tools/unicode_case.py */

static const uint32_t* case_lookup(const ember_case_entry* table, size_t len, uint32_t c) {
    size_t lo = 0, hi = len;
    while (lo < hi) {
        size_t mid = lo + (hi - lo) / 2;
        if (table[mid].cp == c) {
            return table[mid].to;
        }
        if (table[mid].cp < c) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return NULL;
}

/* A character with case: one that either mapping changes. */
static bool is_cased(uint32_t c) {
    return case_lookup(ember_upper_table, ember_upper_table_len, c) != NULL
        || case_lookup(ember_lower_table, ember_lower_table_len, c) != NULL;
}

static void push_char(ember_vec* out, uint32_t c) {
    unsigned char bytes[4];
    ember_vec_extend(out, bytes, encode_utf8(c, bytes));
}

static ember_vec case_map(ember_str s, const ember_case_entry* table, size_t len, bool lower) {
    ember_vec out = ember_vec_empty();
    uint32_t previous = 0;
    size_t at = 0;
    while (at < s.len) {
        uint32_t c = ember_str_char_at(s, at);
        size_t width = ember_char_utf8_len(c);
        /* A capital sigma that ends a word (a cased letter before it and
         * none after it) lowers to the final form. */
        if (lower && c == 0x3A3 && previous != 0 && is_cased(previous)
            && !(at + width < s.len && is_cased(ember_str_char_at(s, at + width)))) {
            push_char(&out, 0x3C2);
        } else {
            const uint32_t* to = case_lookup(table, len, c);
            if (to == NULL) {
                ember_vec_extend(&out, s.ptr + at, width);
            } else {
                for (int i = 0; i < 3 && to[i] != 0; ++i) {
                    push_char(&out, to[i]);
                }
            }
        }
        previous = c;
        at += width;
    }
    return out;
}

/* The digits after `at`, checked against `limit` as they accumulate. */
static uint8_t parse_digits(ember_str s, size_t at, uint64_t limit) {
    if (at >= s.len) {
        return 2;
    }
    uint64_t value = 0;
    for (; at < s.len; ++at) {
        unsigned char c = s.ptr[at];
        if (c < '0' || c > '9') {
            return 2;
        }
        uint64_t digit = (uint64_t)(c - '0');
        if (value > (limit - digit) / 10) {
            return 3;
        }
        value = value * 10 + digit;
    }
    return 0;
}

static uint64_t digits_value(ember_str s, size_t at) {
    uint64_t value = 0;
    for (; at < s.len; ++at) {
        value = value * 10 + (uint64_t)(s.ptr[at] - '0');
    }
    return value;
}

/* A signed type's range is `-max - 1 ..= max`. */
uint8_t ember_parse_signed_status(ember_str s, int64_t max) {
    if (s.len == 0) {
        return 1;
    }
    bool negative = s.ptr[0] == '-';
    size_t at = (s.ptr[0] == '-' || s.ptr[0] == '+') ? 1 : 0;
    uint64_t limit = negative ? (uint64_t)max + 1 : (uint64_t)max;
    return parse_digits(s, at, limit);
}

int64_t ember_parse_signed_value(ember_str s) {
    bool negative = s.ptr[0] == '-';
    size_t at = (s.ptr[0] == '-' || s.ptr[0] == '+') ? 1 : 0;
    uint64_t magnitude = digits_value(s, at);
    return negative ? (int64_t)(0 - magnitude) : (int64_t)magnitude;
}

uint8_t ember_parse_unsigned_status(ember_str s, uint64_t max) {
    if (s.len == 0) {
        return 1;
    }
    return parse_digits(s, s.ptr[0] == '+' ? 1 : 0, max);
}

uint64_t ember_parse_unsigned_value(ember_str s) {
    return digits_value(s, s.ptr[0] == '+' ? 1 : 0);
}

static bool same_letters(const unsigned char* p, size_t len, const char* word) {
    size_t n = strlen(word);
    if (len != n) {
        return false;
    }
    for (size_t i = 0; i < n; ++i) {
        unsigned char c = p[i];
        if (c >= 'A' && c <= 'Z') {
            c = (unsigned char)(c - 'A' + 'a');
        }
        if (c != (unsigned char)word[i]) {
            return false;
        }
    }
    return true;
}

uint8_t ember_parse_float_status(ember_str s) {
    if (s.len == 0) {
        return 1;
    }
    size_t at = (s.ptr[0] == '-' || s.ptr[0] == '+') ? 1 : 0;
    const unsigned char* rest = s.ptr + at;
    size_t len = s.len - at;
    if (same_letters(rest, len, "inf") || same_letters(rest, len, "infinity") || same_letters(rest, len, "nan")) {
        return 0;
    }
    size_t digits = 0;
    while (at < s.len && s.ptr[at] >= '0' && s.ptr[at] <= '9') {
        ++at;
        ++digits;
    }
    if (at < s.len && s.ptr[at] == '.') {
        ++at;
        while (at < s.len && s.ptr[at] >= '0' && s.ptr[at] <= '9') {
            ++at;
            ++digits;
        }
    }
    if (digits == 0) {
        return 2;
    }
    if (at < s.len && (s.ptr[at] == 'e' || s.ptr[at] == 'E')) {
        ++at;
        if (at < s.len && (s.ptr[at] == '-' || s.ptr[at] == '+')) {
            ++at;
        }
        size_t exponent = 0;
        while (at < s.len && s.ptr[at] >= '0' && s.ptr[at] <= '9') {
            ++at;
            ++exponent;
        }
        if (exponent == 0) {
            return 2;
        }
    }
    return at == s.len ? 0 : 2;
}

/* A validated float literal, NUL-terminated for the C library (whose "C"
 * locale reads `.` as the point: the program never changes it). */
static char* float_text(ember_str s, char* small, size_t small_len) {
    char* text = s.len < small_len ? small : (char*)ember_alloc(s.len + 1, 1);
    memcpy(text, s.ptr, s.len);
    text[s.len] = '\0';
    return text;
}

double ember_parse_f64_value(ember_str s) {
    char small[64];
    char* text = float_text(s, small, sizeof small);
    double value = strtod(text, NULL);
    if (text != small) {
        ember_free(text, s.len + 1, 1);
    }
    return value;
}

float ember_parse_f32_value(ember_str s) {
    char small[64];
    char* text = float_text(s, small, sizeof small);
    float value = strtof(text, NULL);
    if (text != small) {
        ember_free(text, s.len + 1, 1);
    }
    return value;
}

/* The significant digits of a decimal number one at a time, and the power of
 * ten of the first: over "-0.0125e3" it yields 1, 2, 5, and its exponent is
 * 1. The text is in the grammar `ember_parse_float_status` checks, or
 * `printf`'s `%e`. */
typedef struct {
    const unsigned char* s;
    size_t at;
    size_t end;
    long exponent;
} decimal_digits;

static decimal_digits decimal_digits_of(const unsigned char* s, size_t n) {
    size_t i = (n > 0 && (s[0] == '-' || s[0] == '+')) ? 1 : 0;
    size_t start = i;
    while (i < n && ((s[i] >= '0' && s[i] <= '9') || s[i] == '.')) {
        ++i;
    }
    size_t end = i;
    long written = 0;
    if (i < n && (s[i] == 'e' || s[i] == 'E')) {
        ++i;
        bool negative = i < n && s[i] == '-';
        if (i < n && (s[i] == '-' || s[i] == '+')) {
            ++i;
        }
        for (; i < n && s[i] >= '0' && s[i] <= '9'; ++i) {
            if (written < 100000000L) {
                written = written * 10 + (long)(s[i] - '0');
            }
        }
        if (negative) {
            written = -written;
        }
    }
    size_t point = end;
    for (size_t k = start; k < end; ++k) {
        if (s[k] == '.') {
            point = k;
            break;
        }
    }
    size_t first = start;
    while (first < end && (s[first] == '0' || s[first] == '.')) {
        ++first;
    }
    long power = first < point ? (long)(point - first) - 1 : -(long)(first - point);
    decimal_digits digits = { s, first, end, power + written };
    return digits;
}

/* The next digit, or -1 when there are no more. */
static int next_decimal_digit(decimal_digits* d) {
    while (d->at < d->end && d->s[d->at] == '.') {
        ++d->at;
    }
    return d->at < d->end ? (int)(d->s[d->at++] - '0') : -1;
}

/* How the magnitude of the decimal text `s` compares with `|x|`, exactly:
 * -1, 0 or 1. `x` is finite and not zero. */
static int compare_decimal_magnitude(ember_str s, double x) {
    char exact[96];
    snprintf(exact, sizeof exact, "%.60e", fabs(x));
    decimal_digits a = decimal_digits_of(s.ptr, s.len);
    decimal_digits b = decimal_digits_of((const unsigned char*)exact, strlen(exact));
    if (a.exponent != b.exponent) {
        return a.exponent < b.exponent ? -1 : 1;
    }
    for (;;) {
        int da = next_decimal_digit(&a);
        int db = next_decimal_digit(&b);
        if (da < 0 && db < 0) {
            return 0;
        }
        if (da < 0) {
            da = 0;
        }
        if (db < 0) {
            db = 0;
        }
        if (da != db) {
            return da < db ? -1 : 1;
        }
    }
}

/* D-316: the `f16` nearest the text. Rounding to `double` first and then to
 * `f16` rounds twice, which can differ from rounding once only when the
 * `double` is exactly halfway between two `f16`s (the text may be just past
 * the midpoint); then the text itself says which side it is on. */
/* An `f16`'s value as a rounding step: the infinity stands one step past the
 * largest finite `f16`, at 2^16. */
static double f16_step_value(uint16_t h, double sign) {
    return (h & 0x7FFFu) == 0x7C00u ? copysign(65536.0, sign) : ember_f16_to_f64(h);
}

uint16_t ember_parse_f16_value(ember_str s) {
    double x = ember_parse_f64_value(s);
    uint16_t h = ember_f64_to_f16(x);
    if (!isfinite(x) || x == 0.0 || fabs(x) > 65536.0) {
        return h;
    }
    double v = f16_step_value(h, x);
    if (v == x) {
        return h;
    }
    /* The other `f16` around `x`, one step further from zero or nearer to
     * it. */
    bool up = fabs(v) < fabs(x);
    uint16_t other = up ? (uint16_t)(h + 1) : (uint16_t)(h - 1);
    double w = f16_step_value(other, x);
    if ((v + w) / 2.0 != x) {
        return h;
    }
    int side = compare_decimal_magnitude(s, x);
    if (side == 0) {
        return h;
    }
    uint16_t smaller = up ? h : other;
    uint16_t larger = up ? other : h;
    return side > 0 ? larger : smaller;
}

uint8_t ember_parse_bool_status(ember_str s) {
    if (s.len == 0) {
        return 1;
    }
    bool is_true = s.len == 4 && memcmp(s.ptr, "true", 4) == 0;
    bool is_false = s.len == 5 && memcmp(s.ptr, "false", 5) == 0;
    return (is_true || is_false) ? 0 : 2;
}

uint8_t ember_parse_char_status(ember_str s) {
    if (s.len == 0) {
        return 1;
    }
    return ember_char_utf8_len(ember_str_char_at(s, 0)) == s.len ? 0 : 2;
}

ember_vec ember_str_to_upper(ember_str s) {
    return case_map(s, ember_upper_table, ember_upper_table_len, false);
}

ember_vec ember_str_to_lower(ember_str s) {
    return case_map(s, ember_lower_table, ember_lower_table_len, true);
}

bool ember_str_contains_char(ember_str text, uint32_t needle) {
    unsigned char encoded[4];
    ember_str piece;
    piece.ptr = encoded;
    piece.len = encode_utf8(needle, encoded);
    return ember_str_contains(text, piece);
}

int ember_str_cmp(ember_str a, ember_str b) {
    size_t n = a.len < b.len ? a.len : b.len;
    int order = n == 0 ? 0 : memcmp(a.ptr, b.ptr, n);
    if (order != 0) {
        return order;
    }
    return (a.len > b.len) - (a.len < b.len);
}

/* -- panics ------------------------------------------------------------------ */

void ember_backtrace_print(void) {
    /* A real backtrace needs the platform unwinder; Phase 0 states the
     * limitation rather than printing something misleading. */
    fputs("note: backtraces are not available in this build\n", stderr);
}

static EMBER_NORETURN void panic_with(const char* msg, size_t len, ember_loc loc) {
    fflush(stdout);
    if (loc.file != NULL) {
        fprintf(stderr, "panic at %s:%u:%u: ", loc.file, loc.line, loc.column);
    } else {
        fputs("panic: ", stderr);
    }
    fwrite(msg, 1, len, stderr);
    fputc('\n', stderr);
    ember_backtrace_print();
    if (g_config.on_panic) {
        g_config.on_panic(msg, len);
    }
    fflush(stderr);
    runtime_abort();
}

void ember_panic(const char* msg, size_t len, ember_loc loc) { panic_with(msg, len, loc); }

void ember_panic_bounds(size_t index, size_t len, ember_loc loc) {
    char buffer[128];
    /* [TYP-31] (0.9.9): a signed index arrives wrapped by its conversion to
     * size_t, and no length reaches the upper half, so print it back signed.
     * ponytail: an unsigned index of 2^63 or more prints negative too. */
    int written = index > (size_t)PTRDIFF_MAX
        ? snprintf(buffer, sizeof buffer, "index %td is out of bounds for a length of %zu",
                   (ptrdiff_t)index, len)
        : snprintf(buffer, sizeof buffer, "index %zu is out of bounds for a length of %zu",
                   index, len);
    panic_with(buffer, written > 0 ? (size_t)written : 0, loc);
}

void ember_panic_overflow(const char* op, ember_loc loc) {
    char buffer[128];
    int written = snprintf(buffer, sizeof buffer, "integer overflow in `%s`", op);
    panic_with(buffer, written > 0 ? (size_t)written : 0, loc);
}

void ember_panic_div_zero(ember_loc loc) { panic_with("division by zero", 16, loc); }

void ember_panic_exclusivity(const char* what, ember_loc loc) {
    char buffer[256];
    const char* subject = what != NULL ? what : "class object";
    int written = snprintf(buffer, sizeof buffer,
                           "exclusivity violation: overlapping access to %s", subject);
    panic_with(buffer, written > 0 ? (size_t)written : 0, loc);
}

void ember_panic_refcell(const char* file, uint32_t line, ember_loc loc) {
    char buffer[512];
    int written;
    if (file != NULL) {
        written = snprintf(buffer, sizeof buffer,
                           "RefCell already mutably borrowed (borrowed at %s:%u)",
                           file, (unsigned)line);
    } else {
        written = snprintf(buffer, sizeof buffer,
                           "RefCell already mutably borrowed (borrowed at unknown:0)");
    }
    panic_with(buffer, written > 0 ? (size_t)written : 0, loc);
}

void ember_panic_unwrap(const char* what, ember_loc loc) {
    char buffer[128];
    int written = snprintf(buffer, sizeof buffer, "unwrap on %s", what);
    panic_with(buffer, written > 0 ? (size_t)written : 0, loc);
}

/* -- printing -----------------------------------------------------------------
 *
 * Floats print as the shortest decimal that reads back as the same value, and
 * an integral value prints without a fractional part: 5.0f prints as "5".
 * Finding the shortest form by trying increasing precision is slower than Ryu
 * but is exact, is twenty lines rather than a thousand, and prints one number
 * per call. std.fmt replaces it in Phase 1.
 */

/* The shortest text that reads back as the same value.
 *
 * Taking the first precision that round-trips is not the same thing: `%.1g`
 * of 10.0 is "1e+01", which round-trips exactly, so a loop that stops there
 * prints 10.0 as "1e+01". Every precision is tried and the shortest result
 * kept, which picks "10" here and still picks "1e+20" over twenty-one
 * digits. */
/* Whether `text` reads back as `v` at the float type `width` bits wide. For
 * `f16` the text goes through `double`: a text this short cannot land on an
 * `f16` midpoint without being it, so rounding twice changes nothing. */
static bool reads_back(const char* text, double v, int width) {
    switch (width) {
    case 16:
        return ember_f64_to_f16(strtod(text, NULL)) == ember_f64_to_f16(v);
    case 32:
        return strtof(text, NULL) == (float)v;
    default:
        return strtod(text, NULL) == v;
    }
}

/* `[STD-20]` (0.9.9): a float's text is Python's `repr`. The digits are the
 * fewest that read back as the same value; they are written in fixed notation
 * when the decimal exponent is in [-4, 16), with `.0` on an integral value
 * (`1.0`, `0.0001`), and in exponent notation otherwise, with a sign and at
 * least two exponent digits (`1e+300`, `1e-05`, `1.5e+16`). NaN and the
 * infinities are `nan`, `inf` and `-inf`. At most 17 digits for `f64`, 9 for
 * `f32` and 5 for `f16` (D-316), the counts that always round-trip. */
static void write_repr(double v, int width, char* out, size_t cap) {
    int max_digits = width == 16 ? 5 : width == 32 ? 9 : 17;
    if (isnan(v)) {
        snprintf(out, cap, "nan");
        return;
    }
    if (isinf(v)) {
        snprintf(out, cap, v < 0 ? "-inf" : "inf");
        return;
    }
    char scientific[40];
    for (int digits = 1; digits <= max_digits; ++digits) {
        snprintf(scientific, sizeof scientific, "%.*e", digits - 1, v);
        if (reads_back(scientific, v, width)) {
            break;
        }
    }
    /* `scientific` is `[-]d[.ddd]e(+|-)XX`: split it into sign, digits and
     * exponent, dropping the trailing zeros of the digits. */
    const char* s = scientific;
    bool negative = *s == '-';
    if (negative) {
        ++s;
    }
    char digits[40];
    int n = 0;
    while (*s != '\0' && *s != 'e' && *s != 'E') {
        if (*s != '.') {
            digits[n++] = *s;
        }
        ++s;
    }
    int exponent = *s != '\0' ? atoi(s + 1) : 0;
    while (n > 1 && digits[n - 1] == '0') {
        --n;
    }
    char text[64];
    size_t at = 0;
    if (negative) {
        text[at++] = '-';
    }
    if (exponent >= -4 && exponent < 16) {
        if (exponent < 0) {
            text[at++] = '0';
            text[at++] = '.';
            for (int zero = 0; zero < -exponent - 1; ++zero) {
                text[at++] = '0';
            }
            for (int i = 0; i < n; ++i) {
                text[at++] = digits[i];
            }
        } else {
            int whole = exponent + 1;
            for (int i = 0; i < whole; ++i) {
                text[at++] = i < n ? digits[i] : '0';
            }
            text[at++] = '.';
            if (whole >= n) {
                text[at++] = '0';
            } else {
                for (int i = whole; i < n; ++i) {
                    text[at++] = digits[i];
                }
            }
        }
        text[at] = '\0';
    } else {
        text[at++] = digits[0];
        if (n > 1) {
            text[at++] = '.';
            for (int i = 1; i < n; ++i) {
                text[at++] = digits[i];
            }
        }
        text[at] = '\0';
        snprintf(text + at, sizeof text - at, "e%c%02d", exponent < 0 ? '-' : '+',
                 exponent < 0 ? -exponent : exponent);
    }
    snprintf(out, cap, "%s", text);
}

static void write_shortest_f64(double v, char* buffer, size_t cap) {
    write_repr(v, 64, buffer, cap);
}

static void write_shortest_f32(float v, char* buffer, size_t cap) {
    write_repr((double)v, 32, buffer, cap);
}

static void write_shortest_f16(uint16_t v, char* buffer, size_t cap) {
    write_repr(ember_f16_to_f64(v), 16, buffer, cap);
}

/* Encode one Unicode scalar value as UTF-8. Returns the byte count. */
static size_t encode_utf8(uint32_t c, unsigned char* out) {
    if (c < 0x80) {
        out[0] = (unsigned char)c;
        return 1;
    }
    if (c < 0x800) {
        out[0] = (unsigned char)(0xC0 | (c >> 6));
        out[1] = (unsigned char)(0x80 | (c & 0x3F));
        return 2;
    }
    if (c < 0x10000) {
        out[0] = (unsigned char)(0xE0 | (c >> 12));
        out[1] = (unsigned char)(0x80 | ((c >> 6) & 0x3F));
        out[2] = (unsigned char)(0x80 | (c & 0x3F));
        return 3;
    }
    out[0] = (unsigned char)(0xF0 | (c >> 18));
    out[1] = (unsigned char)(0x80 | ((c >> 12) & 0x3F));
    out[2] = (unsigned char)(0x80 | ((c >> 6) & 0x3F));
    out[3] = (unsigned char)(0x80 | (c & 0x3F));
    return 4;
}

/* -- 128-bit integers (D-272) ------------------------------------------------
 *
 * The header has the operators. Here are what the halves need beyond them
 * (division and the float conversions), then what both forms share:
 * formatting, `parse` and `range`. */

#if !defined(EMBER_NATIVE_INT128)

/* The leading zero bits of a 64-bit value; 64 for zero. */
static int nlz64(uint64_t x) {
    int n = 0;
    if (x == 0) {
        return 64;
    }
    if (x <= 0x00000000FFFFFFFFu) { n += 32; x <<= 32; }
    if (x <= 0x0000FFFFFFFFFFFFu) { n += 16; x <<= 16; }
    if (x <= 0x00FFFFFFFFFFFFFFu) { n += 8; x <<= 8; }
    if (x <= 0x0FFFFFFFFFFFFFFFu) { n += 4; x <<= 4; }
    if (x <= 0x3FFFFFFFFFFFFFFFu) { n += 2; x <<= 2; }
    if (x <= 0x7FFFFFFFFFFFFFFFu) { n += 1; }
    return n;
}

/* Hacker's Delight's `divlu`: (u1:u0) / v for u1 < v, so the quotient fits
 * 64 bits, in 32-bit digits after normalising v. Each estimated digit is at
 * most two too large; the loops correct it. The remainder through `r` when it
 * is not null. */
static uint64_t divlu(uint64_t u1, uint64_t u0, uint64_t v, uint64_t* r) {
    const uint64_t b = (uint64_t)1 << 32;
    int s = nlz64(v);
    v <<= s;
    uint64_t vn1 = v >> 32, vn0 = v & 0xFFFFFFFFu;
    uint64_t un32 = s == 0 ? u1 : (u1 << s) | (u0 >> (64 - s));
    uint64_t un10 = u0 << s;
    uint64_t un1 = un10 >> 32, un0 = un10 & 0xFFFFFFFFu;
    uint64_t q1 = un32 / vn1, rhat = un32 - q1 * vn1;
    while (q1 >= b || q1 * vn0 > b * rhat + un1) {
        q1 -= 1;
        rhat += vn1;
        if (rhat >= b) {
            break;
        }
    }
    uint64_t un21 = un32 * b + un1 - q1 * v;
    uint64_t q0 = un21 / vn1;
    rhat = un21 - q0 * vn1;
    while (q0 >= b || q0 * vn0 > b * rhat + un0) {
        q0 -= 1;
        rhat += vn1;
        if (rhat >= b) {
            break;
        }
    }
    if (r) {
        *r = (un21 * b + un0 - q0 * v) >> s;
    }
    return q1 * b + q0;
}

ember_u128 ember_u128_divmod(ember_u128 a, ember_u128 b, ember_u128* rem) {
    if (b.hi == 0) {
        /* A 64-bit divisor: the high half first, then its remainder with the
         * low half, which `divlu` takes since that remainder is below b. */
        uint64_t r;
        uint64_t q1 = a.hi / b.lo;
        uint64_t q0 = divlu(a.hi % b.lo, a.lo, b.lo, &r);
        if (rem) {
            *rem = ember_u128_make(0, r);
        }
        return ember_u128_make(q1, q0);
    }
    /* A divisor of 65 bits or more, so the quotient fits 64 bits. Hacker's
     * Delight's doubleword division: estimate from the divisor's top 64 bits
     * (normalised) and half the dividend (so the estimate cannot overflow),
     * which is exact or one too large once one is taken off, then correct. */
    int n = nlz64(b.hi);
    uint64_t v1 = ember_u128_shl(b, (uint32_t)n).hi;
    ember_u128 u1 = ember_u128_shr(a, 1);
    uint64_t q1 = divlu(u1.hi, u1.lo, v1, NULL);
    uint64_t q0 = ember_u128_shr(ember_u128_shl(ember_u128_make(0, q1), (uint32_t)n), 63).lo;
    if (q0 != 0) {
        q0 -= 1;
    }
    ember_u128 r = ember_u128_sub(a, ember_u128_mul(ember_u128_make(0, q0), b));
    if (!ember_u128_lt(r, b)) {
        q0 += 1;
        r = ember_u128_sub(r, b);
    }
    if (rem) {
        *rem = r;
    }
    return ember_u128_make(0, q0);
}

static int nlz128(ember_u128 v) { return v.hi != 0 ? nlz64(v.hi) : 64 + nlz64(v.lo); }

/* `v` rounded to `digits` significant bits, to nearest with ties to even, as
 * a double. Exact: the result has at most 53 bits and is at most 2^128. */
static double u128_round(ember_u128 v, int digits) {
    int length = 128 - nlz128(v);
    if (length <= digits) {
        return (double)v.lo;
    }
    int shift = length - digits;
    uint64_t m = ember_u128_shr(v, (uint32_t)shift).lo;
    ember_u128 rest = ember_u128_sub(v, ember_u128_shl(ember_u128_make(0, m), (uint32_t)shift));
    ember_u128 half = ember_u128_shl(ember_u128_make(0, 1), (uint32_t)(shift - 1));
    if (ember_u128_lt(half, rest) || (ember_u128_eq(rest, half) && (m & 1) != 0)) {
        m += 1;
    }
    return ldexp((double)m, shift);
}

double ember_u128_to_f64(ember_u128 v) { return u128_round(v, 53); }

/* Past `f32`'s largest finite value the rounded result is infinite. */
float ember_u128_to_f32(ember_u128 v) {
    double d = u128_round(v, 24);
    return d >= 340282366920938463463374607431768211456.0 ? (float)HUGE_VAL : (float)d;
}

double ember_i128_to_f64(ember_i128 v) {
    double d = u128_round(ember_i128_magnitude(v), 53);
    return ember_i128_is_negative(v) ? -d : d;
}

float ember_i128_to_f32(ember_i128 v) {
    float f = (float)u128_round(ember_i128_magnitude(v), 24);
    return ember_i128_is_negative(v) ? -f : f;
}

/* [TYP-6]: toward zero, saturating, NaN to 0. Below 2^128 a double's integer
 * part splits exactly into the two halves: the high one is the quotient by
 * 2^64 (an exact scaling) and the low one what is left, which is exact too. */
static ember_u128 u128_from_double(double m) {
    uint64_t hi = (uint64_t)(m / 18446744073709551616.0);
    uint64_t lo = (uint64_t)(m - (double)hi * 18446744073709551616.0);
    return ember_u128_make(hi, lo);
}

ember_i128 ember_ftoi_i128(double v) {
    if (v != v) {
        return ember_i128_make(0, 0);
    }
    if (v <= -170141183460469231731687303715884105728.0) {
        return ember_i128_make(EMBER_I128_SIGN, 0);
    }
    if (v >= 170141183460469231731687303715884105728.0) {
        return ember_i128_make(~EMBER_I128_SIGN, UINT64_MAX);
    }
    ember_u128 m = u128_from_double(v < 0 ? -v : v);
    return ember_u128_to_i128(v < 0 ? ember_u128_neg(m) : m);
}

ember_u128 ember_ftoi_u128(double v) {
    if (v != v || v <= 0) {
        return ember_u128_make(0, 0);
    }
    if (v >= 340282366920938463463374607431768211456.0) {
        return ember_u128_make(UINT64_MAX, UINT64_MAX);
    }
    return u128_from_double(v);
}

#endif /* the halves */

/* The digits of `hi:lo` in `base` (2 to 16), least significant first, into
 * `reversed`; returns how many. Above 64 bits the value is divided in 32-bit
 * pieces, which needs no 128-bit division; the quotient of a value of 65 bits
 * or more by at most 16 is never 0, so no leading zero appears. */
static size_t digits_reversed(uint64_t hi, uint64_t lo, unsigned base, const char* numerals, char* reversed) {
    size_t n = 0;
    while (hi != 0) {
        uint64_t limbs[4] = {hi >> 32, hi & 0xFFFFFFFFu, lo >> 32, lo & 0xFFFFFFFFu};
        uint64_t rest = 0;
        for (int i = 0; i < 4; ++i) {
            uint64_t current = (rest << 32) | limbs[i];
            limbs[i] = current / base;
            rest = current % base;
        }
        hi = (limbs[0] << 32) | limbs[1];
        lo = (limbs[2] << 32) | limbs[3];
        reversed[n++] = numerals[rest];
    }
    do {
        reversed[n++] = numerals[lo % base];
        lo /= base;
    } while (lo != 0);
    return n;
}

/* An integer's `Display`: a `-` below zero, then its decimal digits. `text`
 * holds 41 bytes, enough for `i128`'s least value. */
static size_t integer_text(char* text, bool negative, uint64_t hi, uint64_t lo) {
    char reversed[40];
    size_t n = digits_reversed(hi, lo, 10, "0123456789", reversed);
    size_t at = 0;
    if (negative) {
        text[at++] = '-';
    }
    while (n > 0) {
        text[at++] = reversed[--n];
    }
    return at;
}

void ember_fmt_i128(ember_vec* out, ember_i128 value) {
    char text[41];
    ember_u128 m = ember_i128_magnitude(value);
    ember_vec_extend(out, text, integer_text(text, ember_i128_is_negative(value), ember_u128_hi(m), ember_u128_lo(m)));
}

void ember_fmt_u128(ember_vec* out, ember_u128 value) {
    char text[41];
    ember_vec_extend(out, text, integer_text(text, false, ember_u128_hi(value), ember_u128_lo(value)));
}

/* `[TXT-10]` (ODR-029) — `parse` for 128-bit integers, with the statuses the
 * 64-bit forms give. */
static uint8_t parse_digits128(ember_str s, size_t at, ember_u128 limit) {
    if (at >= s.len) {
        return 2;
    }
    ember_u128 value = ember_u128_make(0, 0);
    ember_u128 ten = ember_u128_make(0, 10);
    for (; at < s.len; ++at) {
        unsigned char c = s.ptr[at];
        if (c < '0' || c > '9') {
            return 2;
        }
        ember_u128 digit = ember_u128_make(0, (uint64_t)(c - '0'));
        if (ember_u128_gt(value, ember_u128_div(ember_u128_sub(limit, digit), ten))) {
            return 3;
        }
        value = ember_u128_add(ember_u128_mul(value, ten), digit);
    }
    return 0;
}

static ember_u128 digits_value128(ember_str s, size_t at) {
    ember_u128 value = ember_u128_make(0, 0);
    for (; at < s.len; ++at) {
        value = ember_u128_add(ember_u128_mul(value, ember_u128_make(0, 10)), ember_u128_make(0, (uint64_t)(s.ptr[at] - '0')));
    }
    return value;
}

uint8_t ember_parse_i128_status(ember_str s) {
    if (s.len == 0) {
        return 1;
    }
    bool negative = s.ptr[0] == '-';
    size_t at = (s.ptr[0] == '-' || s.ptr[0] == '+') ? 1 : 0;
    ember_u128 limit = negative ? ember_u128_make(EMBER_I128_SIGN, 0) : ember_u128_make(~EMBER_I128_SIGN, UINT64_MAX);
    return parse_digits128(s, at, limit);
}

ember_i128 ember_parse_i128_value(ember_str s) {
    bool negative = s.ptr[0] == '-';
    size_t at = (s.ptr[0] == '-' || s.ptr[0] == '+') ? 1 : 0;
    ember_u128 magnitude = digits_value128(s, at);
    return ember_u128_to_i128(negative ? ember_u128_neg(magnitude) : magnitude);
}

uint8_t ember_parse_u128_status(ember_str s) {
    if (s.len == 0) {
        return 1;
    }
    return parse_digits128(s, s.ptr[0] == '+' ? 1 : 0, ember_u128_make(UINT64_MAX, UINT64_MAX));
}

ember_u128 ember_parse_u128_value(ember_str s) {
    return digits_value128(s, s.ptr[0] == '+' ? 1 : 0);
}

/* `[STD-26]` over 128-bit integers, as over 64-bit ones. A count past
 * `SIZE_MAX` is `SIZE_MAX`: no loop runs that long. */
static size_t saturated_count(ember_u128 distance, ember_u128 step) {
    ember_u128 one = ember_u128_make(0, 1);
    ember_u128 count = ember_u128_add(ember_u128_div(ember_u128_sub(distance, one), step), one);
    if (ember_u128_hi(count) != 0) {
        return SIZE_MAX;
    }
#if SIZE_MAX < UINT64_MAX
    if (ember_u128_lo(count) > SIZE_MAX) {
        return SIZE_MAX;
    }
#endif
    return (size_t)ember_u128_lo(count);
}

size_t ember_range_count_i128(ember_i128 start, ember_i128 stop, ember_i128 step) {
    ember_u128 from = ember_i128_to_u128(start), to = ember_i128_to_u128(stop);
    if (!ember_i128_is_negative(step)) {
        if (!ember_i128_lt(start, stop)) {
            return 0;
        }
        return saturated_count(ember_u128_sub(to, from), ember_i128_to_u128(step));
    }
    if (!ember_i128_lt(stop, start)) {
        return 0;
    }
    return saturated_count(ember_u128_sub(from, to), ember_i128_magnitude(step));
}

size_t ember_range_count_u128(ember_u128 start, ember_u128 stop, ember_u128 step) {
    if (!ember_u128_lt(start, stop)) {
        return 0;
    }
    return saturated_count(ember_u128_sub(stop, start), step);
}

/* Wrapping arithmetic: the true value lies between `start` and `stop`. */
ember_i128 ember_range_nth_i128(ember_i128 start, ember_i128 step, size_t k) {
    return ember_i128_add(start, ember_i128_mul(ember_i128_from_u64((uint64_t)k), step));
}

ember_u128 ember_range_nth_u128(ember_u128 start, ember_u128 step, size_t k) {
    return ember_u128_add(start, ember_u128_mul(ember_u128_from_u64((uint64_t)k), step));
}

/* `[STD-9]` — each type has one printer taking its stream; `print`/`println`
 * write to standard output and `eprint`/`eprintln` to standard error. */
static void print_str_to(FILE* out, ember_str s) {
    if (s.len > 0) {
        fwrite(s.ptr, 1, s.len, out);
    }
}

static void print_i64_to(FILE* out, int64_t v) { fprintf(out, "%" PRId64, v); }
static void print_u64_to(FILE* out, uint64_t v) { fprintf(out, "%" PRIu64, v); }

static void print_i128_to(FILE* out, ember_i128 v) {
    char text[41];
    ember_u128 m = ember_i128_magnitude(v);
    fwrite(text, 1, integer_text(text, ember_i128_is_negative(v), ember_u128_hi(m), ember_u128_lo(m)), out);
}

static void print_u128_to(FILE* out, ember_u128 v) {
    char text[41];
    fwrite(text, 1, integer_text(text, false, ember_u128_hi(v), ember_u128_lo(v)), out);
}

static void print_f16_to(FILE* out, uint16_t v) {
    char buffer[32];
    write_shortest_f16(v, buffer, sizeof buffer);
    fputs(buffer, out);
}

static void print_f32_to(FILE* out, float v) {
    char buffer[32];
    write_shortest_f32(v, buffer, sizeof buffer);
    fputs(buffer, out);
}

static void print_f64_to(FILE* out, double v) {
    char buffer[32];
    write_shortest_f64(v, buffer, sizeof buffer);
    fputs(buffer, out);
}

static void print_bool_to(FILE* out, bool v) { fputs(v ? "true" : "false", out); }

static void print_char_to(FILE* out, uint32_t v) {
    unsigned char buffer[4];
    size_t n = encode_utf8(v, buffer);
    fwrite(buffer, 1, n, out);
}

#define EMBER_PRINTERS(suffix, type)                                              \
    void ember_print_##suffix(type v) { print_##suffix##_to(stdout, v); }        \
    void ember_println_##suffix(type v) {                                       \
        print_##suffix##_to(stdout, v);                                         \
        fputc('\n', stdout);                                                    \
    }                                                                           \
    void ember_eprint_##suffix(type v) { print_##suffix##_to(stderr, v); }       \
    void ember_eprintln_##suffix(type v) {                                      \
        print_##suffix##_to(stderr, v);                                         \
        fputc('\n', stderr);                                                    \
    }

EMBER_PRINTERS(str, ember_str)
EMBER_PRINTERS(i64, int64_t)
EMBER_PRINTERS(u64, uint64_t)
EMBER_PRINTERS(i128, ember_i128)
EMBER_PRINTERS(u128, ember_u128)
EMBER_PRINTERS(f16, uint16_t)
EMBER_PRINTERS(f32, float)
EMBER_PRINTERS(f64, double)
EMBER_PRINTERS(bool, bool)
EMBER_PRINTERS(char, uint32_t)

/* `[STD-10]` — `input(prompt)`: the prompt, flushed, then one line of
 * standard input without its `\n` (or `\r\n`). The prelude's console
 * functions treat a console failure as fatal: end of input panics, and the
 * message names the `Result` form in `std.io`. */
ember_vec ember_input(ember_str prompt, ember_loc loc) {
    print_str_to(stdout, prompt);
    fflush(stdout);
    ember_vec line = ember_vec_empty();
    int read_any = 0;
    int c;
    while ((c = getchar()) != EOF) {
        read_any = 1;
        if (c == '\n') {
            break;
        }
        uint8_t byte = (uint8_t)c;
        ember_vec_push(&line, 1, &byte);
    }
    if (!read_any) {
        static const char message[] =
            "input: end of input; `std.io.stdin().read_line()` returns it as a `Result` instead";
        ember_vec_free(&line, 1);
        ember_panic(message, sizeof message - 1, loc);
    }
    if (line.len > 0 && ((uint8_t*)line.ptr)[line.len - 1] == '\r') {
        line.len -= 1;
    }
    return line;
}

/* -- formatting -------------------------------------------------------------- */

void ember_fmt_i64(ember_vec* out, int64_t value) {
    char buffer[32];
    int n = snprintf(buffer, sizeof buffer, "%lld", (long long)value);
    if (n > 0) {
        ember_vec_extend(out, buffer, (size_t)n);
    }
}

void ember_fmt_u64(ember_vec* out, uint64_t value) {
    char buffer[32];
    int n = snprintf(buffer, sizeof buffer, "%llu", (unsigned long long)value);
    if (n > 0) {
        ember_vec_extend(out, buffer, (size_t)n);
    }
}

void ember_fmt_f64(ember_vec* out, double value) {
    char buffer[32];
    write_shortest_f64(value, buffer, sizeof buffer);
    ember_vec_extend(out, buffer, strlen(buffer));
}

void ember_fmt_f32(ember_vec* out, float value) {
    char buffer[32];
    write_shortest_f32(value, buffer, sizeof buffer);
    ember_vec_extend(out, buffer, strlen(buffer));
}

void ember_fmt_f16(ember_vec* out, uint16_t value) {
    char buffer[32];
    write_shortest_f16(value, buffer, sizeof buffer);
    ember_vec_extend(out, buffer, strlen(buffer));
}

void ember_fmt_bool(ember_vec* out, bool value) {
    const char* text = value ? "true" : "false";
    ember_vec_extend(out, text, strlen(text));
}

void ember_fmt_char(ember_vec* out, uint32_t value) {
    unsigned char buffer[4];
    size_t n = encode_utf8(value, buffer);
    ember_vec_extend(out, buffer, n);
}

void ember_fmt_str(ember_vec* out, ember_str value) {
    ember_vec_extend(out, value.ptr, value.len);
}

/* -- `[LEX-19]` format specs ------------------------------------------------ */

static size_t utf8_count(const unsigned char* s, size_t n) {
    size_t count = 0;
    for (size_t i = 0; i < n; ++i) {
        count += (s[i] & 0xC0) != 0x80;
    }
    return count;
}

static void push_fill(ember_vec* out, uint32_t fill, size_t count) {
    unsigned char buffer[4];
    size_t n = encode_utf8(fill, buffer);
    for (size_t i = 0; i < count; ++i) {
        ember_vec_extend(out, buffer, n);
    }
}

/* `prefix` (a sign, `0x`) then `body`, padded to the width: `align` or the
 * type's default, `^` putting the odd fill on the right. */
static void emit_padded(ember_vec* out, const char* prefix, const unsigned char* body, size_t body_len,
                        const ember_fmt_spec* spec, char default_align) {
    size_t prefix_len = strlen(prefix);
    size_t len = prefix_len + utf8_count(body, body_len);
    size_t pad = spec->width > len ? spec->width - len : 0;
    char align = spec->align ? spec->align : default_align;
    size_t left = align == '>' ? pad : (align == '^' ? pad / 2 : 0);
    push_fill(out, spec->fill, left);
    ember_vec_extend(out, prefix, prefix_len);
    ember_vec_extend(out, body, body_len);
    push_fill(out, spec->fill, pad - left);
}

/* `digits` with `sep` every `every` digits from the right, after `zeros`
 * leading zeros. */
static void group_digits(ember_vec* out, const char* digits, size_t n, size_t zeros, char sep, int every) {
    size_t total = n + zeros;
    for (size_t i = 0; i < total; ++i) {
        if (sep && i > 0 && (total - i) % (size_t)every == 0) {
            ember_vec_extend(out, &sep, 1);
        }
        char c = i < zeros ? '0' : digits[i - zeros];
        ember_vec_extend(out, &c, 1);
    }
}

static size_t grouped_length(size_t digits, char sep, int every) {
    return digits + (sep && digits > 0 ? (digits - 1) / (size_t)every : 0);
}

/* A number: `prefix`, then the integer digits (grouped, and zero-padded to the
 * width when the `0` flag is set and no alignment is), then `rest` (a
 * fraction, an exponent, a `%`). */
static void emit_number(ember_vec* out, const char* prefix, const char* digits, size_t n, const char* rest,
                        const ember_fmt_spec* spec, int every) {
    ember_vec body = ember_vec_empty();
    size_t rest_len = strlen(rest);
    size_t zeros = 0;
    if (spec->zero && !spec->align) {
        size_t need = spec->width > strlen(prefix) + rest_len ? spec->width - strlen(prefix) - rest_len : 0;
        while (grouped_length(n + zeros, spec->grouping, every) < need) {
            ++zeros;
        }
    }
    group_digits(&body, digits, n, zeros, spec->grouping, every);
    ember_vec_extend(&body, rest, rest_len);
    emit_padded(out, prefix, (const unsigned char*)body.ptr, body.len, spec, '>');
    ember_vec_free(&body, 1);
}

static void sign_prefix(char* prefix, bool negative, const ember_fmt_spec* spec) {
    size_t at = 0;
    if (negative) {
        prefix[at++] = '-';
    } else if (spec->sign == '+' || spec->sign == ' ') {
        prefix[at++] = spec->sign;
    }
    prefix[at] = '\0';
}

static void fmt_spec_float(ember_vec* out, double value, int width, ember_fmt_spec spec);

/* `snprintf` of one precision and one double into a buffer of the size it
 * needs, which the caller frees. */
static char* print_sized(const char* format, int precision, double value) {
    int size = snprintf(NULL, 0, format, precision, value);
    char* text = (char*)malloc((size_t)size + 1);
    snprintf(text, (size_t)size + 1, format, precision, value);
    return text;
}

/* The magnitude is `hi:lo`, so one function serves every width (D-272). */
static void fmt_spec_integer(ember_vec* out, bool negative, uint64_t hi, uint64_t lo, ember_fmt_spec spec) {
    char kind = spec.kind == 0 || spec.kind == '?' ? 'd' : spec.kind;
    if (strchr("eEfFgG%", kind)) {
        double value = ember_u128_to_f64(ember_u128_make(hi, lo));
        fmt_spec_float(out, negative ? -value : value, 64, spec);
        return;
    }
    unsigned base = kind == 'x' || kind == 'X' ? 16 : kind == 'b' ? 2 : kind == 'o' ? 8 : 10;
    const char* numerals = kind == 'X' ? "0123456789ABCDEF" : "0123456789abcdef";
    char reversed[136];
    size_t n = digits_reversed(hi, lo, base, numerals, reversed);
    char digits[136];
    for (size_t i = 0; i < n; ++i) {
        digits[i] = reversed[n - 1 - i];
    }
    char prefix[8];
    sign_prefix(prefix, negative, &spec);
    if (spec.alternate && base != 10) {
        size_t at = strlen(prefix);
        prefix[at++] = '0';
        prefix[at++] = kind;
        prefix[at] = '\0';
    }
    emit_number(out, prefix, digits, n, "", &spec, base == 10 ? 3 : 4);
}

void ember_fmt_spec_i64(ember_vec* out, int64_t value, ember_fmt_spec spec) {
    uint64_t magnitude = value < 0 ? (uint64_t)(-(value + 1)) + 1 : (uint64_t)value;
    fmt_spec_integer(out, value < 0, 0, magnitude, spec);
}

void ember_fmt_spec_u64(ember_vec* out, uint64_t value, ember_fmt_spec spec) {
    fmt_spec_integer(out, false, 0, value, spec);
}

void ember_fmt_spec_i128(ember_vec* out, ember_i128 value, ember_fmt_spec spec) {
    ember_u128 m = ember_i128_magnitude(value);
    fmt_spec_integer(out, ember_i128_is_negative(value), ember_u128_hi(m), ember_u128_lo(m), spec);
}

void ember_fmt_spec_u128(ember_vec* out, ember_u128 value, ember_fmt_spec spec) {
    fmt_spec_integer(out, false, ember_u128_hi(value), ember_u128_lo(value), spec);
}

static void fmt_spec_float(ember_vec* out, double value, int width, ember_fmt_spec spec) {
    bool negative = signbit(value) && !isnan(value);
    double magnitude = fabs(value);
    char prefix[4];
    sign_prefix(prefix, negative, &spec);
    char kind = spec.kind;
    bool upper = kind == 'E' || kind == 'F' || kind == 'G';
    if (!isfinite(magnitude)) {
        const char* word = isnan(magnitude) ? (upper ? "NAN" : "nan") : (upper ? "INF" : "inf");
        ember_fmt_spec plain = spec;
        plain.zero = false;
        emit_padded(out, prefix, (const unsigned char*)word, strlen(word), &plain, '>');
        return;
    }
    int precision = spec.precision < 0 ? 6 : spec.precision;
    char format[16];
    ember_vec text = ember_vec_empty();
    char* printed = NULL;
    if (kind == 0 && spec.precision < 0) {
        char repr[64];
        write_repr(magnitude, width, repr, sizeof repr);
        ember_vec_extend(&text, repr, strlen(repr));
    } else if (kind == '?') {
        char repr[64];
        write_repr(magnitude, width, repr, sizeof repr);
        ember_vec_extend(&text, repr, strlen(repr));
    } else if (kind == 0) {
        /* A precision and no type is `g` with at least one digit after the
         * point (CPython's `Py_DTSF_ADD_DOT_0`): exponent notation from an
         * exponent of `precision - 1` up, one step earlier than `g`, and
         * trailing zeros dropped. */
        int digits = precision == 0 ? 1 : precision;
        char* scientific = print_sized("%.*e", digits - 1, magnitude);
        int exponent = atoi(strchr(scientific, 'e') + 1);
        if (exponent < -4 || exponent >= digits - 1) {
            char* e = strchr(scientific, 'e');
            size_t end = (size_t)(e - scientific);
            while (end > 1 && scientific[end - 1] == '0') {
                --end;
            }
            if (scientific[end - 1] == '.') {
                --end;
            }
            ember_vec_extend(&text, scientific, end);
            ember_vec_extend(&text, e, strlen(e));
        } else {
            char* fixed = print_sized("%.*f", digits - 1 - exponent, magnitude);
            size_t end = strlen(fixed);
            if (strchr(fixed, '.')) {
                while (fixed[end - 1] == '0' && fixed[end - 2] != '.') {
                    --end;
                }
                ember_vec_extend(&text, fixed, end);
            } else {
                ember_vec_extend(&text, fixed, end);
                ember_vec_extend(&text, ".0", 2);
            }
            free(fixed);
        }
        free(scientific);
    } else {
        double shown = kind == '%' ? magnitude * 100.0 : magnitude;
        char letter = kind == '%' ? 'f' : kind;
        snprintf(format, sizeof format, "%%%s.*%c", spec.alternate ? "#" : "", letter);
        printed = print_sized(format, precision, shown);
        ember_vec_extend(&text, printed, strlen(printed));
        free(printed);
        if (kind == '%') {
            ember_vec_extend(&text, "%", 1);
        }
    }
    /* Split the integer digits from the rest, so they can be grouped. */
    const char* s = (const char*)text.ptr;
    size_t n = 0;
    while (n < text.len && s[n] >= '0' && s[n] <= '9') {
        ++n;
    }
    char* rest = (char*)malloc(text.len - n + 1);
    memcpy(rest, s + n, text.len - n);
    rest[text.len - n] = '\0';
    emit_number(out, prefix, s, n, rest, &spec, 3);
    free(rest);
    ember_vec_free(&text, 1);
}

void ember_fmt_spec_f64(ember_vec* out, double value, ember_fmt_spec spec) {
    fmt_spec_float(out, value, 64, spec);
}

void ember_fmt_spec_f32(ember_vec* out, float value, ember_fmt_spec spec) {
    fmt_spec_float(out, (double)value, 32, spec);
}

void ember_fmt_spec_f16(ember_vec* out, uint16_t value, ember_fmt_spec spec) {
    fmt_spec_float(out, ember_f16_to_f64(value), 16, spec);
}

/* Python's `repr` of text: single quotes unless the text holds one and no
 * double quote; `\\`, the quote, `\n`, `\r`, `\t` and other control bytes
 * escaped. ponytail: non-printable Unicode above ASCII is written as is;
 * Python escapes it. */
static void repr_text(ember_vec* out, const unsigned char* s, size_t n) {
    bool single_quote = memchr(s, '\'', n) != NULL;
    bool double_quote = memchr(s, '"', n) != NULL;
    char quote = single_quote && !double_quote ? '"' : '\'';
    ember_vec_extend(out, &quote, 1);
    for (size_t i = 0; i < n; ++i) {
        unsigned char c = s[i];
        char escape[5];
        if (c == (unsigned char)quote || c == '\\') {
            escape[0] = '\\';
            escape[1] = (char)c;
            ember_vec_extend(out, escape, 2);
        } else if (c == '\n' || c == '\r' || c == '\t') {
            escape[0] = '\\';
            escape[1] = c == '\n' ? 'n' : (c == '\r' ? 'r' : 't');
            ember_vec_extend(out, escape, 2);
        } else if (c < 0x20 || c == 0x7F) {
            snprintf(escape, sizeof escape, "\\x%02x", c);
            ember_vec_extend(out, escape, 4);
        } else {
            ember_vec_extend(out, &c, 1);
        }
    }
    ember_vec_extend(out, &quote, 1);
}

/* Text, or its `repr` for `?`; a precision keeps that many characters. */
static void fmt_spec_text(ember_vec* out, const unsigned char* s, size_t n, bool quoted, ember_fmt_spec spec) {
    ember_vec body = ember_vec_empty();
    if (quoted) {
        repr_text(&body, s, n);
    } else {
        ember_vec_extend(&body, s, n);
    }
    size_t len = body.len;
    if (spec.precision >= 0) {
        size_t kept = 0;
        len = 0;
        const unsigned char* b = (const unsigned char*)body.ptr;
        while (len < body.len) {
            if ((b[len] & 0xC0) != 0x80) {
                if (kept == (size_t)spec.precision) {
                    break;
                }
                ++kept;
            }
            ++len;
        }
    }
    emit_padded(out, "", (const unsigned char*)body.ptr, len, &spec, '<');
    ember_vec_free(&body, 1);
}

void ember_fmt_spec_str(ember_vec* out, ember_str value, ember_fmt_spec spec) {
    fmt_spec_text(out, value.ptr, value.len, spec.kind == '?', spec);
}

/* `[TYP-36]` — a class handle's `Debug`: its class and address. The class is
 * the object's own, read from its header, so a handle held as a base class or
 * an interface still names what it points at. */
void ember_fmt_handle(ember_vec* out, const void* object) {
    const ember_obj_header* header = (const ember_obj_header*)object;
    char address[48];
    int n = snprintf(address, sizeof address, " at %p>", object);
    ember_vec_extend(out, "<", 1);
    ember_vec_extend(out, header->ti->name, strlen(header->ti->name));
    ember_vec_extend(out, address, n > 0 ? (size_t)n : 0);
}

/* `[TXT-4]` — a byte offset that starts a character, or is the end. */
bool ember_str_is_char_boundary(ember_str s, size_t i) {
    return i == 0 || i == s.len || (i < s.len && (s.ptr[i] & 0xC0) != 0x80);
}

/* `[TYP-39]` — inside a collection, text shows as its `Debug`: quoted as
 * Python's `repr` quotes it. A `char` is text of one character. */
void ember_fmt_repr_str(ember_vec* out, ember_str value) {
    repr_text(out, value.ptr, value.len);
}

void ember_fmt_repr_char(ember_vec* out, uint32_t value) {
    unsigned char buffer[4];
    size_t n = encode_utf8(value, buffer);
    repr_text(out, buffer, n);
}

void ember_fmt_spec_bool(ember_vec* out, bool value, ember_fmt_spec spec) {
    const char* word = value ? "true" : "false";
    fmt_spec_text(out, (const unsigned char*)word, strlen(word), false, spec);
}

void ember_fmt_spec_char(ember_vec* out, uint32_t value, ember_fmt_spec spec) {
    unsigned char buffer[4];
    size_t n = encode_utf8(value, buffer);
    fmt_spec_text(out, buffer, n, spec.kind == '?', spec);
}

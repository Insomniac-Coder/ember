/* [FFI-33a]: in the debug profile an object that is not Sync belongs to the thread that made it.
 * A foreign thread that attaches (`ember_rt_thread_attach`) and then retains or releases such an
 * object panics, naming the class and both threads; a Sync object is any thread's, and the maker
 * itself retains and releases freely. Compiled with EMBER_RT_DEBUG_ACCESS (the debug profile).
 * Run with one argument: `retain`, `release`, `weak`, `sync` or `same`. The panic hook prints the
 * message and ends the process. */
#if !defined(_WIN32)
#define _POSIX_C_SOURCE 200809L
#endif
#include "ember_rt.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#if defined(_WIN32)
#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#else
#include <pthread.h>
#endif

static void report(const char* msg, size_t len) {
    fwrite(msg, 1, len, stdout);
    fputc('\n', stdout);
    fflush(stdout);
    exit(0);
}

static const ember_type_info plain_ti = {
    sizeof(ember_obj_header), _Alignof(ember_obj_header), 0, "Node", NULL, NULL, NULL, NULL, NULL, 0, NULL, 0,
};

static const ember_type_info sync_ti = {
    sizeof(ember_obj_header), _Alignof(ember_obj_header), EMBER_TI_SYNC, "Shared Node", NULL, NULL, NULL, NULL, NULL, 0, NULL, 0,
};

static ember_obj_header* g_object;
static const char* g_mode;

#if defined(_WIN32)
static DWORD WINAPI foreign(void* raw) {
#else
static void* foreign(void* raw) {
#endif
    (void)raw;
    ember_rt_thread_attach();
    if (strcmp(g_mode, "release") == 0) {
        ember_release_plain(g_object);
    } else if (strcmp(g_mode, "weak") == 0) {
        ember_weak_retain(g_object);
    } else if (strcmp(g_mode, "sync") == 0) {
        ember_retain(g_object);
        ember_release(g_object);
    } else {
        ember_retain_plain(g_object);
    }
#if defined(_WIN32)
    return 0;
#else
    return NULL;
#endif
}

int main(int argc, char** argv) {
    if (argc != 2) return 2;
    g_mode = argv[1];
    ember_rt_config cfg = ember_rt_config_default();
    cfg.on_panic = report;
    if (ember_rt_init(&cfg) != 0) return 3;
    g_object = ember_obj_new(strcmp(g_mode, "sync") == 0 ? &sync_ti : &plain_ti);
    ember_retain_plain(g_object);
    ember_release_plain(g_object);
    if (strcmp(g_mode, "same") == 0) {
        puts("ok");
        return 0;
    }
#if defined(_WIN32)
    HANDLE thread = CreateThread(NULL, 0, foreign, NULL, 0, NULL);
    if (!thread) return 4;
    if (WaitForSingleObject(thread, INFINITE) != WAIT_OBJECT_0) return 4;
    CloseHandle(thread);
#else
    pthread_t thread;
    if (pthread_create(&thread, NULL, foreign, NULL) != 0) return 4;
    if (pthread_join(thread, NULL) != 0) return 4;
#endif
    puts("ok");
    return 0;
}

/* [RT-7]: a count never rolls over. A retain of an object whose owner count is at its maximum stops
 * the program with `too many owners of a `<Class>` (4,294,967,295)`, for a plain object (the header's
 * inline retain and its out-of-line end); a Sync one, whose count several threads add to, stops when
 * the count before the add is at or above half the range, `(2,147,483,647)`; a weak retain the same
 * way, `too many `weakref` links to a `<Class>` (...)`; a retain of an object whose count is zero is
 * still the invalid-object panic. The panic hook prints the message and ends the process before the
 * runtime aborts. Run with one argument: `plain`, `sync`, `weak`, `weak_sync` or `zero`. */
#include "ember_rt.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

static void report(const char* msg, size_t len) {
    fwrite(msg, 1, len, stdout);
    fputc('\n', stdout);
    fflush(stdout);
    exit(0);
}

static const ember_type_info plain_ti = {
    sizeof(ember_obj_header), _Alignof(ember_obj_header), 0, "Node", NULL, NULL, NULL, NULL, NULL, 0, NULL, 0,
};

static const ember_type_info sync_ti = {
    sizeof(ember_obj_header), _Alignof(ember_obj_header), EMBER_TI_SYNC, "Shared Node", NULL, NULL, NULL, NULL, NULL, 0, NULL, 0,
};

int main(int argc, char** argv) {
    if (argc != 2) return 2;
    ember_rt_config cfg = ember_rt_config_default();
    cfg.on_panic = report;
    if (ember_rt_init(&cfg) != 0) return 3;
    const char* mode = argv[1];
    bool sync = strcmp(mode, "sync") == 0 || strcmp(mode, "weak_sync") == 0;
    ember_obj_header* object = ember_obj_new(sync ? &sync_ti : &plain_ti);
    if (strcmp(mode, "weak") == 0 || strcmp(mode, "weak_sync") == 0) {
        object->weak = (sync ? EMBER_COUNT_HALF : EMBER_COUNT_MAX) - 1u;
        ember_weak_retain(object);
        if (object->weak != (sync ? EMBER_COUNT_HALF : EMBER_COUNT_MAX)) return 4;
        ember_weak_retain(object);
        return 5;
    }
    object->strong = strcmp(mode, "zero") == 0 ? 0 : (sync ? EMBER_COUNT_HALF : EMBER_COUNT_MAX) - 1u;
    if (sync) {
        ember_retain_sync(object);
        if (object->strong != EMBER_COUNT_HALF) return 4;
        ember_retain_sync(object);
    } else {
        ember_retain_plain(object);
        if (strcmp(mode, "zero") != 0 && object->strong != EMBER_COUNT_MAX) return 4;
        ember_retain_plain(object);
    }
    return 5;
}

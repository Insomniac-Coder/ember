/* [JOB-1], [JOB-2], [JOB-3]: the job system's pool. 2000 jobs of one scope each add their number to
 * a shared total, and the scope's end returns only after every one has run; a job whose state is
 * larger than its slot's 64 bytes runs from a heap block with that state intact; a job submitted
 * after another starts only once that one has ended; and waiting on a detached job returns once
 * it has run. More jobs than slots are submitted, so a full queue is waited out. */
#if !defined(_WIN32)
#define _POSIX_C_SOURCE 200809L
#endif
#include "ember_rt.h"
#include <stdio.h>
#include <string.h>

#define JOBS 2000

static volatile int64_t g_total;
static uintptr_t g_word;

typedef struct { int64_t n; } small_state;
typedef struct { int64_t values[24]; } large_state;
typedef struct { int64_t* slot; int64_t value; } order_state;

static void add(void* raw) {
    small_state* s = (small_state*)raw;
    ember_mutex_lock(&g_word);
    g_total = g_total + s->n;
    ember_mutex_unlock(&g_word);
}

static void add_large(void* raw) {
    large_state* s = (large_state*)raw;
    int64_t sum = 0;
    for (int i = 0; i < 24; ++i) sum += s->values[i];
    ember_mutex_lock(&g_word);
    g_total = g_total + sum;
    ember_mutex_unlock(&g_word);
}

static int64_t g_first;
static int64_t g_second_saw;

static void first(void* raw) {
    (void)raw;
    for (volatile int spin = 0; spin < 2000000; ++spin) {}
    g_first = 1;
}

static void second(void* raw) {
    (void)raw;
    g_second_saw = g_first;
}

int main(void) {
    ember_loc loc = { "job_pool.c", 0, 0 };
    ember_jobs_set_workers(3);
    uint32_t scope = 0;
    int64_t expected = 0;
    for (int64_t i = 1; i <= JOBS; ++i) {
        small_state s = { i };
        expected += i;
        (void)ember_job_submit(&scope, add, NULL, &s, sizeof s, _Alignof(small_state), NULL, 0, 0, 0, loc);
    }
    large_state big;
    for (int i = 0; i < 24; ++i) { big.values[i] = 1000; expected += 1000; }
    (void)ember_job_submit(&scope, add_large, NULL, &big, sizeof big, _Alignof(large_state), NULL, 0, 0, 0, loc);
    ember_job_scope_end(&scope);
    if (g_total != expected) { printf("total %lld, expected %lld\n", (long long)g_total, (long long)expected); return 2; }
    uint64_t a = ember_job_submit(NULL, first, NULL, NULL, 0, 1, NULL, 0, 0, 0, loc);
    uint64_t b = ember_job_submit(NULL, second, NULL, NULL, 0, 1, &a, 1, sizeof a, 0, loc);
    ember_job_wait(b);
    ember_job_wait(a);
    if (g_second_saw != 1) { printf("a job ran before the one it waits on\n"); return 3; }
    printf("ok\n");
    return 0;
}

/* [STA-3]: a static's initialiser runs once, even when several threads ask
 * for it first at the same time; the others wait for it, then see its value.
 * The accessor is the one the compiler writes for a lazily initialised
 * static. */
#if !defined(_WIN32)
/* `-std=c11` hides POSIX: `nanosleep` needs it asked for. */
#define _POSIX_C_SOURCE 200809L
#endif
#include "ember_rt.h"
#if defined(_WIN32)
#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#else
#include <pthread.h>
#include <time.h>
#endif

#define WORKERS 4

static volatile int g_runs;

static int slow_initialiser(void) {
    g_runs += 1;
#if defined(_WIN32)
    Sleep(30);
#else
    struct timespec pause = { 0, 30 * 1000 * 1000 };
    nanosleep(&pause, NULL);
#endif
    return 42;
}

static int* value_static(void) {
    static int storage;
    static uint32_t state;
    if (ember_rt_static_begin(&state, "VALUE")) {
        storage = slow_initialiser();
        ember_rt_static_end(&state);
    }
    return &storage;
}

static int g_seen[WORKERS];

#if defined(_WIN32)
static DWORD WINAPI worker(void* raw) {
#else
static void* worker(void* raw) {
#endif
    int index = (int)(intptr_t)raw;
    g_seen[index] = *value_static();
#if defined(_WIN32)
    return 0;
#else
    return NULL;
#endif
}

int main(void) {
#if defined(_WIN32)
    HANDLE threads[WORKERS];
    for (int i = 0; i < WORKERS; ++i) {
        threads[i] = CreateThread(NULL, 0, worker, (void*)(intptr_t)i, 0, NULL);
        if (!threads[i]) return 2;
    }
    for (int i = 0; i < WORKERS; ++i) {
        if (WaitForSingleObject(threads[i], INFINITE) != WAIT_OBJECT_0) return 2;
        if (!CloseHandle(threads[i])) return 2;
    }
#else
    pthread_t threads[WORKERS];
    for (int i = 0; i < WORKERS; ++i) {
        if (pthread_create(&threads[i], NULL, worker, (void*)(intptr_t)i)) return 2;
    }
    for (int i = 0; i < WORKERS; ++i) {
        if (pthread_join(threads[i], NULL)) return 2;
    }
#endif
    if (g_runs != 1) return 3;
    for (int i = 0; i < WORKERS; ++i) {
        if (g_seen[i] != 42) return 4;
    }
    puts("ok");
    return 0;
}

/* The runtime's own hot-reload test, image B: the edit of image A. `f`'s body changed and reads
 * the static, which keeps its value ([HR-17]); `gone` was removed ([HR-7]). See reload_image_a. */
#include "ember_rt.h"

static void (*targets[1])(void);
static void (*addresses[1])(void);
static const void* descriptors[1];
static void* static_data[1];
static uint32_t* static_state[1];

static int64_t f_body(int64_t x) { return x + 100 + *(const int64_t*)static_data[0]; }
int64_t f(int64_t x) { return ((int64_t (*)(int64_t))targets[0])(x); }
static const int64_t counter_initial = 40;

static const ember_rl_fn fns[1] = {
    { "f", (void (*)(void))f_body, (void (*)(void))f, NULL, 1, 0, EMBER_RL_FN_RELOADABLE },
};
static const ember_rl_static statics[1] = {
    { "counter", 8, 8, 7, 9, EMBER_RL_STATIC_CONSTANT, &counter_initial, NULL, NULL },
};

EMBER_RL_MANIFEST const ember_rl_manifest ember_test_manifest = {
    EMBER_RELOAD_MAGIC, EMBER_RELOAD_PROTOCOL, (uint32_t)sizeof(ember_rl_manifest),
    (uint32_t)sizeof(ember_obj_header), 2u, "t",
#if defined(EMBER_RELOAD_INSTANCES)
    ember_obj_header_v40,
#else
    ember_obj_header_v24,
#endif
    ember_reload_protocol_v1,
    1u, fns, targets, addresses, descriptors,
    1u, statics, static_data, static_state,
    0u, NULL,
    0u, NULL,
    NULL,
};
